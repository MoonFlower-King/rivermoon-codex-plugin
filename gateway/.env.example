NODE_ENV=production
HOST=127.0.0.1
PORT=8787
PUBLIC_BASE_URL=https://rivermoon7.com
MCP_PATH=/codex-mcp
OAUTH_PREFIX=/codex-oauth
FILES_PATH=/codex-files
NEWAPI_BASE_URL=http://127.0.0.1:3000
IMAGE_API_BASE_URL=http://127.0.0.1:8320
STANDARD_GROUP=default
PRO_GROUP=4k
STANDARD_TOKEN_NAME=rivermoon-codex-standard
PRO_TOKEN_NAME=rivermoon-codex-pro
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_SECONDS=2592000
STATE_FILE=/var/lib/rivermoon-codex-gateway/state.json
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY_BASE64=
MAX_INLINE_IMAGE_BYTES=16777216

# Short-lived download cache for images above the inline limit.
# The server runs on a single small system disk, so keep the cap conservative.
ARTIFACT_DIR=/var/lib/rivermoon-codex-gateway/artifacts
ARTIFACT_TTL_SECONDS=1800
ARTIFACT_MAX_TOTAL_BYTES=536870912

# Upstream timeouts and retry policy.
UPSTREAM_TIMEOUT_MS=30000
IMAGE_TIMEOUT_MS=180000
UPSTREAM_RETRIES=2
RETRY_BASE_DELAY_MS=500
RETRY_MAX_DELAY_MS=8000

# Quota display. QUOTA_PER_UNIT is the NewAPI quota units per 1 USD.
# Set the per-image costs to show a remaining-image estimate; 0 hides it.
QUOTA_PER_UNIT=500000
STANDARD_IMAGE_COST_USD=0
PRO_IMAGE_COST_USD=0
