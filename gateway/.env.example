NODE_ENV=production
HOST=127.0.0.1
PORT=8787
PUBLIC_BASE_URL=https://rivermoon7.com
MCP_PATH=/codex-mcp
OAUTH_PREFIX=/codex-oauth
NEWAPI_BASE_URL=http://127.0.0.1:3000
IMAGE_API_BASE_URL=http://127.0.0.1:8320
STANDARD_GROUP=default
PRO_GROUP=4k
STANDARD_TOKEN_NAME=rivermoon-codex-standard
PRO_TOKEN_NAME=rivermoon-codex-pro
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_SECONDS=2592000
STATE_FILE=/var/lib/rivermoon-codex-gateway/state.json
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY_BASE64=
MAX_INLINE_IMAGE_BYTES=16777216
